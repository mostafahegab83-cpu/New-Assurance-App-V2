rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Review form attachments:
    // attachments/{recordId}/{attachmentId}_{filename}
    match /attachments/{recordId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                            && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // Document Control attachments:
    // dc_documents/{docId}/{timestamp}_{filename}
    match /dc_documents/{docId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                            && request.resource.size <= 50 * 1024 * 1024;
      allow delete: if isSignedIn();
    }

    // Deny every other Storage path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
