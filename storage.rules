rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email in ['mostafa.hegab83@gmail.com'];
    }
    function isApproved() {
      return isSignedIn() && (
        isSuperAdmin()
        || firestore.exists(
             /databases/(default)/documents/approved_users/$(request.auth.token.email)
           )
      );
    }
    function isAdmin() {
      return isSuperAdmin() || (
        isApproved()
        && firestore.get(
             /databases/(default)/documents/approved_users/$(request.auth.token.email)
           ).data.role == 'admin'
      );
    }

    // Document Control attachments — uploaded under dc_documents/{docId}/...
    match /dc_documents/{docId}/{allPaths=**} {
      allow read:   if isApproved();
      allow create: if isApproved()
                    && request.resource.size < 50 * 1024 * 1024; // 50 MB cap
      allow update: if isApproved()
                    && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isApproved();
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
