rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Review record attachments
    match /attachments/{recordId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
    // Document control attachments
    match /dc_documents/{docId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
    // Published dashboard PDFs: only signed-in users can upload/list.
    // The generated download link (with its secret token) opens without login.
    match /shared_reports/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
