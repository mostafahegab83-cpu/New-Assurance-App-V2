// ============================================================================
//  PASTE THESE FUNCTIONS + MATCH BLOCKS *INSIDE* YOUR EXISTING
//      match /databases/{database}/documents { ... }
//  Keep all your existing assurance-tracker rules untouched.
//  Everything here uses new, prefixed names (hub*, hub_users, pmo_projects).
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- PMO hub: begin ----------
    function hubSignedIn() { return request.auth != null && request.auth.token.email != null; }
    function hubSuper()    { return hubSignedIn() && request.auth.token.email.lower() == 'mostafa.hegab83@gmail.com'; }
    function hubMe()       { return get(/databases/$(database)/documents/hub_users/$(request.auth.token.email.lower())).data; }
    function hubCanEdit(page) {
      return hubSuper() || (hubSignedIn()
        && exists(/databases/$(database)/documents/hub_users/$(request.auth.token.email.lower()))
        && hubMe().active == true
        && page in hubMe().pages);
    }

    match /hub_users/{email} {
      allow read: if hubSignedIn() && (request.auth.token.email.lower() == email || hubSuper());
      allow create, delete: if hubSuper();
      allow update: if hubSuper()
        || (request.auth.token.email.lower() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']));
    }

    // public read (dashboards viewable without login), editors write
    match /pmo_projects/{id}      { allow read: if true; allow write: if hubCanEdit('pmo'); }
    match /excellence_data/{id}   { allow read: if true; allow write: if hubCanEdit('excellence'); }
    match /strategic_data/{id}    { allow read: if true; allow write: if hubCanEdit('strategic'); }
    // ---------- PMO hub: end ----------

    // ... your existing assurance-tracker rules stay here ...
  }
}
